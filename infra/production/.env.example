# ============================================================
# Variáveis de Ambiente - Produção ERP Móveis
# Copie para .env e preencha os valores reais
# NUNCA comite o arquivo .env no repositório!
# ============================================================

# Banco de dados
DB_NAME=erp_moveis
DB_USER=erp_user
DB_PASSWORD=SENHA_FORTE_AQUI

# JWT
JWT_SECRET=SEU_SECRET_HEX_64_CHARS_AQUI

# Imagens Docker (GitHub Container Registry)
BACKEND_IMAGE=ghcr.io/291294/gestao/backend:prod-latest
FRONTEND_IMAGE=ghcr.io/291294/gestao/frontend:prod-latest

# SMTP (Gmail: use App Password, não a senha normal)
# Para gerar App Password: myaccount.google.com → Segurança → Senhas de app
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# CORS - domínio do frontend em produção
CORS_ORIGINS=http://192.168.1.11:3001
